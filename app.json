{
  "expo": {
    "name": "Encontrar",
    "slug": "directorio-comercios-cdelu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.org.ccu.directorio",
      "infoPlist": {
        "NSCameraUsageDescription": "La app necesita acceso a la cámara para escanear los códigos QR de promociones de los clientes.",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte los comercios más cercanos en Concepción del Uruguay."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "edu.uner.cdelucomercios",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E3A8A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a -Encontrar- escanear códigos QR en el mostrador."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir a Comercios CdelU ordenar locales por distancia."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      "expo-font"
    ],
    "scheme": "comercios-cdelu",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "17e75ae8-8ac5-45c7-bf0b-18dc0745d8f1"
      }
    },
    "owner": "florrmammana"
  }
}